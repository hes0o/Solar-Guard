# Copy to .env (git-ignored) and fill in. scripts/run.sh loads it.
SOLARGUARD_MANAGER_PASSWORD=change-me
SOLARGUARD_STAFF_PASSWORD=change-me
# Long random string; keeps people logged in across restarts. Generate: python3 -c "import secrets;print(secrets.token_hex(32))"
SOLARGUARD_SECRET=change-me
# 1 when served over HTTPS (e.g. behind Cloudflare Tunnel)
SOLARGUARD_SECURE_COOKIE=0
